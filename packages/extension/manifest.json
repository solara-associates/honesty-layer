{
  "manifest_version": 3,
  "name": "Honesty Layer",
  "short_name": "Honesty Layer",
  "version": "0.3.0",
  "description": "Calibrated, non-sycophantic feedback on claude.ai and chatgpt.com — see exactly what was added to your prompt and why.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Honesty Layer"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
